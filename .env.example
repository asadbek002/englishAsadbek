# ── AI ──────────────────────────────────────────────
# auto   — avval Gemini (tekin), u ishlamasa Claude (standart)
# gemini — faqat Gemini
# claude — faqat Claude
AI_PROVIDER=auto

# Gemini kaliti — tekin: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude kaliti — zaxira (pullik): https://platform.claude.com → API Keys
# Bo'sh qoldirsangiz, faqat Gemini ishlaydi.
ANTHROPIC_API_KEY=
# Arzon zaxira: claude-haiku-5-5 · Eng aniq baholash: claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5

# Bir foydalanuvchiga kunlik AI so'rovlar soni
AI_DAILY_LIMIT=40

# ── Server ──────────────────────────────────────────
# Tokenlarni imzolash uchun uzun tasodifiy satr: openssl rand -hex 32
JWT_SECRET=
PORT=8787
